# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_username
DB_PASSWORD=your_password

# Optional: Hugging Face mirror (China)
HF_MIRROR=https://hf-mirror.com

